  * nv_drm_plane_atomic_reset - plane state reset hook
  * @plane: DRM plane
@@ -2080,6 +2101,7 @@ static void nv_drm_plane_atomic_reset(struct drm_plane *plane)
         kfree(nv_plane_state);
     }
 }
+#endif
 
 
