diff --git a/Makefile b/Makefile
index d5adfd6..3724d98 100644
--- a/Makefile
+++ b/Makefile
@@ -976,6 +976,40 @@ KBUILD_CFLAGS	+= $(CONFIG_CC_OPT_ALLOW_STORE_DATA_RACES_PARAM)
 KBUILD_CFLAGS	+= $(CONFIG_CC_OPT_NO_ALLOW_STORE_DATA_RACES)
 endif
 
+ifdef CONFIG_CC_IS_CLANG
+    # =========================================================
+    # Base Clang (No LTO / Pure AutoFDO Setup)
+    # =========================================================
+    KBUILD_CFLAGS += \
+        -mllvm=-enable-pipeliner \
+        -mllvm=-unroll-threshold=50 \
+        -mllvm=-unroll-max-count=8
+
+    ifndef CONFIG_LTO_CLANG
+    KBUILD_CFLAGS += -mllvm=-inline-threshold=360
+    endif
+
+    # =========================================================
+    # LTO-Enabled Environments
+    # Optimized inline ceiling to prevent I-cache thrashing
+    # =========================================================
+    ifdef CONFIG_LTO_CLANG
+
+        # Thin-LTO / Distributed Thin-LTO Specific Rules
+        ifeq ($(or $(CONFIG_LTO_CLANG_THIN),$(CONFIG_LTO_CLANG_THIN_DIST)),y)
+        THINLTO_JOBS := $(shell nproc | awk '{print int(2.6 * sqrt($$1))}')
+        KBUILD_CFLAGS += -mllvm=-inline-threshold=320
+        KBUILD_LDFLAGS += --thinlto-jobs=$(THINLTO_JOBS)
+        endif
+
+        # Full-LTO Specific Rules
+        ifdef CONFIG_LTO_CLANG_FULL
+        KBUILD_CFLAGS += -mllvm=-inline-threshold=280
+        endif
+
+    endif
+endif
+
 ifdef CONFIG_READABLE_ASM
 # Disable optimizations that make assembler listings hard to read.
 # reorder blocks reorders the control in the function
